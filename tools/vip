#!/bin/sh
# Working project entry when macOS make is blocked by the Xcode license.
set -eu
cd "$(dirname "$0")/.."
case "${1:-help}" in
  dev|start) exec backend/.venv/bin/python tools/local_manage.py start ;;
  dev-api) exec backend/.venv/bin/python tools/local_manage.py start-api ;;
  dev-down|stop) exec backend/.venv/bin/python tools/local_manage.py stop ;;
  migrate) exec backend/.venv/bin/python tools/local_manage.py migrate ;;
  migrate-test) exec backend/.venv/bin/python tools/local_manage.py migrate-test ;;
  seed-synthetic) exec backend/.venv/bin/python tools/local_manage.py seed-test ;;
  test|check-slice) cd backend; exec .venv/bin/python -m pytest tests/ -q ;;
  build-ui) exec npm --prefix frontend run build ;;
  baostock-import) shift; cd backend; exec .venv/bin/python scripts_baostock.py "$@" ;;
  financial-import) shift; cd backend; exec .venv/bin/python scripts_financial.py "$@" ;;
  seal) shift; cd backend; exec .venv/bin/python scripts_seal.py "$@" ;;
  original-import) shift; cd backend; exec .venv/bin/python scripts_original_inputs.py "$@" ;;
  issuer-import) shift; cd backend; exec .venv/bin/python scripts_issuer_reports.py "$@" ;;
  disclosure-import) shift; cd backend; exec .venv/bin/python scripts_issuer_disclosures.py "$@" ;;
  eodhd-import) shift; cd backend; exec .venv/bin/python scripts_eodhd.py "$@" ;;
  ecb-fx-import) shift; cd backend; exec .venv/bin/python scripts_ecb_fx.py "$@" ;;
  futu-import) shift; cd backend; exec .venv/bin/python scripts_futu.py "$@" ;;
  public-import) cd backend; exec .venv/bin/python scripts_public.py --enable-wikimedia ;;
  *) echo 'Usage: tools/vip migrate | seed-synthetic | test | build-ui | dev | dev-api | dev-down | public-import | baostock-import/financial-import (--capture or --snapshot /absolute/path) | issuer-import/disclosure-import (--snapshot /absolute/path --workspace ID [--write]) | eodhd-import (--capture or --snapshot /absolute/path --workspace ID [--write]) | ecb-fx-import | futu-import (--check or --capture --start YYYY-MM-DD --end YYYY-MM-DD --rights /absolute/local/path or --snapshot /absolute/path [--workspace ID --currency-basis /absolute/local/path --write]) | original-import | seal';;
esac
