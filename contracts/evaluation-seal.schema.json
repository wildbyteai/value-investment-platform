{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "release_id": {
      "type": "string",
      "format": "uuid"
    },
    "security_id": {
      "type": "string",
      "format": "uuid"
    },
    "primary_listing_id": {
      "type": "string",
      "format": "uuid"
    },
    "market_session": {
      "type": "string",
      "minLength": 1
    },
    "evaluation_as_of": {
      "type": "string",
      "format": "date-time"
    },
    "knowledge_cutoff": {
      "type": "string",
      "format": "date-time"
    },
    "expected_generation": {
      "type": "integer",
      "minimum": 0
    },
    "manifest_id": {
      "type": "string",
      "format": "uuid"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "release_id",
    "security_id",
    "primary_listing_id",
    "market_session",
    "evaluation_as_of",
    "knowledge_cutoff",
    "expected_generation",
    "manifest_id",
    "manifest_sha256"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evaluation seal command; internal strategy service only"
}
