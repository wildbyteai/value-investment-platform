{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "entry_key": {
      "type": "string",
      "minLength": 1
    },
    "content_kind": {
      "enum": [
        "source_document",
        "agent_report",
        "agent_digest"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary_text": {
      "type": [
        "string",
        "null"
      ]
    },
    "reading_metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "material_type": {
          "enum": [
            "news",
            "announcement",
            "interview",
            "research_report",
            "market_followup",
            "industry_context"
          ]
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "person_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "person_role": {
          "type": [
            "string",
            "null"
          ]
        },
        "summary_origin": {
          "enum": [
            "upstream_agent",
            "source_excerpt",
            "system_generated",
            "none"
          ]
        },
        "generator_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "agent_commentary": {
          "type": [
            "string",
            "null"
          ]
        },
        "watch_points": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_reading_priority": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "raw": {
                  "type": "string",
                  "minLength": 1
                },
                "scale": {
                  "enum": [
                    "stars",
                    "rank",
                    "label"
                  ]
                }
              },
              "required": [
                "raw",
                "scale"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "material_type",
        "topics",
        "person_name",
        "person_role",
        "summary_origin",
        "generator_ref",
        "agent_commentary",
        "watch_points",
        "source_reading_priority"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "summary_origin": {
                "const": "system_generated"
              }
            }
          },
          "then": {
            "properties": {
              "generator_ref": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "date": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "precision": {
          "enum": [
            "instant",
            "minute",
            "day",
            "part_of_day",
            "unknown"
          ]
        },
        "timezone": {
          "type": [
            "string",
            "null"
          ]
        },
        "raw": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "at",
        "date",
        "precision",
        "timezone",
        "raw"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "precision": {
                "enum": [
                  "instant",
                  "minute"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "at": {
                "type": "string",
                "format": "date-time"
              },
              "date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "timezone": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "else": {
            "properties": {
              "at": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "precision": {
                "enum": [
                  "day",
                  "part_of_day"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "precision": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "properties": {
              "date": {
                "type": "null"
              },
              "at": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "parent_revision_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "origin_locator": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sheet": {
              "type": "string",
              "minLength": 1
            },
            "range": {
              "type": "string",
              "pattern": "^[A-Z]+[1-9][0-9]*(:[A-Z]+[1-9][0-9]*)?$"
            }
          },
          "required": [
            "sheet",
            "range"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "source_references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "reference_key": {
            "type": "string",
            "minLength": 1
          },
          "source_name": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "locator_kind": {
            "enum": [
              "article",
              "list",
              "account",
              "unknown"
            ]
          },
          "source_locator": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "sheet": {
                    "type": "string",
                    "minLength": 1
                  },
                  "range": {
                    "type": "string",
                    "pattern": "^[A-Z]+[1-9][0-9]*(:[A-Z]+[1-9][0-9]*)?$"
                  }
                },
                "required": [
                  "sheet",
                  "range"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "reference_key",
          "source_name",
          "url",
          "locator_kind",
          "source_locator"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "entry_key",
    "content_kind",
    "title",
    "summary_text",
    "reading_metadata",
    "publication",
    "parent_revision_id",
    "origin_locator",
    "source_references"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "content_kind": {
            "const": "agent_digest"
          }
        }
      },
      "then": {
        "properties": {
          "parent_revision_id": {
            "type": "string",
            "format": "uuid"
          },
          "origin_locator": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "sheet": {
                "type": "string",
                "minLength": 1
              },
              "range": {
                "type": "string",
                "pattern": "^[A-Z]+[1-9][0-9]*(:[A-Z]+[1-9][0-9]*)?$"
              }
            },
            "required": [
              "sheet",
              "range"
            ]
          },
          "reading_metadata": {
            "properties": {
              "summary_origin": {
                "const": "upstream_agent"
              }
            }
          }
        }
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InformationEntry 1.0 — parser output, not accepted judgment",
  "description": "发布与取得时间不同；服务端生成item/revision/observed_at；跨记录身份/权限/时区语义见docs/04 §6。"
}
