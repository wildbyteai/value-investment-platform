{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "registry_key": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "dimension": {
            "type": "string",
            "pattern": "^(profit_quality|financial_resilience|business_model|governance|growth_sustainability|x_[a-z0-9_]+)$"
          },
          "applicable_industries": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "allowed_baseline_methods": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "weighted_metric_rubric",
                "accepted_evidence_rubric"
              ]
            }
          },
          "quality_policy": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "evidence_requirement": {
                "enum": [
                  "accessible_original",
                  "issuer_or_regulator_original"
                ]
              },
              "freshness": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "const": "report_obligation"
                      }
                    },
                    "required": [
                      "kind"
                    ]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "const": "age_days"
                      },
                      "max_age_days": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 3650
                      }
                    },
                    "required": [
                      "kind",
                      "max_age_days"
                    ]
                  }
                ]
              }
            },
            "required": [
              "evidence_requirement",
              "freshness"
            ]
          },
          "event_policy": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "enabled": {
                    "const": false
                  }
                },
                "required": [
                  "enabled"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "enabled": {
                    "const": true
                  },
                  "half_life_days": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 730
                  }
                },
                "required": [
                  "enabled",
                  "half_life_days"
                ]
              }
            ]
          }
        },
        "required": [
          "dimension",
          "applicable_industries",
          "allowed_baseline_methods",
          "quality_policy",
          "event_policy"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "registry_key",
    "version",
    "entries"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Versioned dimension registry defaults; publication is human controlled"
}
