# Copy to deploy/secrets/app.env and chmod 600. Only the app containers receive this file.
# Fill in only the keys you use; leave the rest out entirely.

# Master key that encrypts model API keys entered on 后台设置 › 模型配置 (AES-256-GCM, ADR 0015).
# 32 random bytes in base64. Generate once per server:   openssl rand -base64 32
# Back it up SEPARATELY from the database backups: without it, page-saved keys cannot be decrypted
# (re-enter them on the page). Leave empty to keep using only the environment-variable keys below.
# Rotation: move the old value to VIP_SECRET_KEY_PREVIOUS, set a new VIP_SECRET_KEY, restart, run
#   docker compose run --rm api python -m app.admin_cli rotate-secret-key   then remove the _PREVIOUS line.
VIP_SECRET_KEY=
# VIP_SECRET_KEY_PREVIOUS=

# Models — optional when the key is entered on the page (the page key wins).
# (names must look like VIP_*_KEY; keys are only ever sent to the vendor hosts in config/model-presets-v1.json and news-radar-v1.json,
# plus any host listed in VIP_LLM_ALLOWED_HOSTS)
VIP_DEEPSEEK_API_KEY=
VIP_OPENAI_API_KEY=
# VIP_QWEN_API_KEY=
# VIP_ZHIPU_API_KEY=
# VIP_MOONSHOT_API_KEY=
# VIP_ANTHROPIC_API_KEY=
# VIP_GEMINI_API_KEY=
# VIP_ARK_API_KEY=
# VIP_MINIMAX_API_KEY=
# Only if the server cannot reach a vendor directly and you run your own HTTPS proxy:
# VIP_LLM_ALLOWED_HOSTS=llm-proxy.example.com

# Alert e-mail
VIP_SMTP_HOST=
VIP_SMTP_PORT=465
VIP_SMTP_USER=
VIP_SMTP_PASSWORD=
VIP_SMTP_STARTTLS=false
VIP_ALERT_SENDER=admin@bytewatcher.xyz
