{
  "schema_version": "1.0",
  "policy_key": "news-collector-standard",
  "version": 1,
  "name": "资讯采集定时器 v1",
  "timezone": "Asia/Shanghai",
  "max_items_per_run": 40,
  "max_tool_rounds": 8,
  "request_timeout_seconds": 240,
  "min_interval_minutes": 60,
  "scheduler_tick_minutes": 5,
  "stale_run_minutes": 30,
  "output_excerpt_chars": 4000,
  "score_after_collect": true,
  "search_modes": {
    "none": {
      "label": "不联网"
    },
    "qwen_enable_search": {
      "label": "通义千问 · 内置联网（enable_search）",
      "search_options": {
        "forced_search": true,
        "search_strategy": "max"
      }
    },
    "zhipu_web_search": {
      "label": "智谱 GLM · web_search 工具",
      "web_search": {
        "enable": true,
        "search_engine": "search_pro",
        "search_result": true,
        "search_recency_filter": "oneDay",
        "count": 20
      }
    },
    "kimi_search": {
      "label": "Kimi · 官方搜索接口（同一个 Key）",
      "endpoint": "/tools/search_pro",
      "limit": 8,
      "timeout_seconds": 30
    },
    "openai_web_search": {
      "label": "OpenAI · Responses 接口 web_search 工具",
      "endpoint": "/responses",
      "tool": {
        "type": "web_search"
      },
      "tool_choice": "required",
      "request_timeout_seconds": 900,
      "system_as_instructions": true
    },
    "anthropic_web_search": {
      "label": "Claude · Messages 接口 web_search 工具",
      "endpoint": "/messages",
      "anthropic_version": "2023-06-01",
      "tool": {
        "type": "web_search_20260318",
        "name": "web_search",
        "max_uses": 8,
        "allowed_callers": [
          "direct"
        ]
      },
      "max_tokens": 16000,
      "request_timeout_seconds": 600
    },
    "doubao_web_search": {
      "label": "豆包（火山方舟）· Responses 接口 web_search 工具",
      "endpoint": "/responses",
      "tool": {
        "type": "web_search",
        "sources": [
          "doubao"
        ]
      },
      "max_tool_calls": 10,
      "system_as_instructions": false,
      "request_timeout_seconds": 600
    }
  },
  "notes": "Kimi 的 $web_search 内置工具预计 2026-10-20 下线，所以 kimi_search 用 Kimi 官方 /v1/tools/search_pro 接口（与对话同一个 Key）以函数调用方式接入。 模型预设已移到 config/model-presets-v1.json。anthropic_web_search 用 Anthropic 原生 Messages 接口的服务端 web_search 工具（allowed_callers=[\"direct\"] 关闭动态过滤，输出更可预测；去掉该项即启用动态过滤）。doubao_web_search 复用 Responses 接口解析（与 openai_web_search 同一段代码），工具为豆包搜索 Custom 版。"
}
