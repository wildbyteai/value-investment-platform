VIP_DB_URL=postgresql+psycopg2://vip_app:SET_LOCALLY@127.0.0.1:5432/vip_v0001_local
# VIP_TEST_DB_URL must name only the disposable project synthetic test database.
# Personal-use EODHD key; explicit eodhd-import only, never fetched on startup.
EODHD_API_TOKEN=
# 资讯雷达 AI 关联打分（R5）。默认模型 DeepSeek；后台 › 模型配置 可换成任何 OpenAI 兼容模型，
# 每个模型只登记“密钥所在的环境变量名”，密钥本身只放环境变量，不进数据库、不进 Git。
VIP_DEEPSEEK_API_KEY=
# 监控告警邮件（R6）。发件人默认 admin@bytewatcher.xyz（config/alerts-v1.json），可用 VIP_ALERT_SENDER 覆盖。
# 未配置 VIP_SMTP_HOST 时只发站内通知，邮件记为“已跳过”。465=隐式 TLS；587 时设 VIP_SMTP_STARTTLS=true。
VIP_SMTP_HOST=
VIP_SMTP_PORT=465
VIP_SMTP_USER=
VIP_SMTP_PASSWORD=
VIP_SMTP_STARTTLS=false
VIP_ALERT_SENDER=
